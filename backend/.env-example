# Copy this file to the .env file and fill in values for local development.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS (comma-separated origins allowed to call this API) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
# Leave everything below empty to fall back to local SQLite automatically.
#
# Option A: single connection string (used by Render/Railway) - takes priority
DATABASE_URL=

# Option B: individual Postgres variables (used if DATABASE_URL is empty)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSL_REQUIRE=True

# Option C: only used when neither of the above is set (local SQLite filename)
SQLITE_NAME=db.sqlite3

# --- Production hardening (only applied when DEBUG=False) ---
SECURE_SSL_REDIRECT=True